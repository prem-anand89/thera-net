#!/bin/sh
# Agent branches never push. Gemini works in its own worktree on gemini/* and Claude reviews
# and merges; pushing is a decision for the owner. (--no-verify would skip this, which the
# standing rules forbid; the worktree's push URL is also disabled, see scripts/gemini-worktree.sh.)
branch=$(git rev-parse --abbrev-ref HEAD 2>/dev/null)
top=$(git rev-parse --show-toplevel 2>/dev/null)
case "$branch" in
  gemini/*)
    echo "Push blocked: gemini/* branches are never pushed. Claude reviews and merges them."
    exit 1
    ;;
esac
case "$top" in
  *thera-net-gemini*)
    echo "Push blocked: this is the Gemini worktree. Claude reviews and merges; nothing is pushed from here."
    exit 1
    ;;
esac

echo "Running pre-push checks (typecheck and lint)..."
npm run typecheck && npm run lint
if [ $? -ne 0 ]; then
  echo "Pre-push checks failed. Push aborted."
  exit 1
fi
echo "Pre-push checks passed."
exit 0
