# Supabase project settings (Project Settings → API in the Supabase dashboard)
# Set these as environment variables in Vercel dashboard → Project Settings → Environment Variables
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Slack/Discord incoming webhook so production errors are visible
# VITE_ERROR_WEBHOOK_URL=https://hooks.slack.com/services/...

# Playwright authenticated e2e (optional). Cloud Agent / local Supabase from
# `.cursor/start.sh` defaults to admin@thera.local / testpass123 when the URL
# is 127.0.0.1 — set these explicitly for a hosted staging project.
# E2E_EMAIL=admin@thera.local
# E2E_PASSWORD=testpass123
